{
  "name": "@penline/core",
  "version": "0.1.0",
  "description": "Headless rich-text editor engine: model, invertible ops, transactions, history, plugins and a DOM view. Framework-free.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "editor",
    "rich-text",
    "headless",
    "contenteditable",
    "wysiwyg",
    "penline"
  ],
  "homepage": "https://github.com/DaoHuyTuan/headless-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaoHuyTuan/headless-editor.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/DaoHuyTuan/headless-editor/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./internal": "./src/internal.ts",
    "./testing": "./src/testing/index.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts src/internal.ts src/testing/index.ts --format esm --dts --clean --tsconfig ../../tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./internal": {
        "types": "./dist/internal.d.ts",
        "import": "./dist/internal.js"
      },
      "./testing": {
        "types": "./dist/testing/index.d.ts",
        "import": "./dist/testing/index.js"
      }
    }
  },
  "dependencies": {
    "@standard-schema/spec": "^1.0.0"
  }
}
