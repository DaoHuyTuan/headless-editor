{
  "name": "@penline/code-block",
  "version": "0.1.0",
  "description": "Code block for penline: plain-text blocks with syntax highlighting.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "keywords": [
    "editor",
    "rich-text",
    "headless",
    "contenteditable",
    "wysiwyg",
    "penline"
  ],
  "homepage": "https://github.com/DaoHuyTuan/headless-editor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaoHuyTuan/headless-editor.git",
    "directory": "packages/plugins/code-block"
  },
  "bugs": {
    "url": "https://github.com/DaoHuyTuan/headless-editor/issues"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx"
  },
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx --format esm --dts --clean --tsconfig ../../../tsconfig.build.json",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./react": {
        "types": "./dist/react.d.ts",
        "import": "./dist/react.js"
      }
    }
  },
  "dependencies": {
    "highlight.js": "^11.10.0",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@penline/react": "workspace:^",
    "@penline/core": "workspace:^"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "@penline/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@penline/bold": "workspace:*",
    "@penline/mention": "workspace:*",
    "@penline/paragraph": "workspace:*",
    "@penline/react": "workspace:*",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@penline/core": "workspace:*"
  }
}
